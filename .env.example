# ============================================
# AI QUANT TRADING PLATFORM
# Environment Configuration
# ============================================
# COPY this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# ── System ──────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Trading Mode ────────────────────────────
# CRITICAL: Must be "paper" during development
# Changing to "live" requires safety checklist
TRADING_MODE=paper

# ── Database ────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trading_platform
DATABASE_USER=trading
DATABASE_PASSWORD=CHANGE_ME_trading_secure_password
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── Alpaca Markets ──────────────────────────
# Get keys from: https://app.alpaca.markets/
# Paper trading keys (default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2
ALPACA_FEED=iex

# ── SEC EDGAR ───────────────────────────────
# No API key required. User-Agent is mandatory.
SEC_EDGAR_USER_AGENT=AIQuantPlatform contact@example.com
SEC_EDGAR_RATE_LIMIT=10

# ── Google Gemini AI (News & Catalyst Intelligence) ──
# Optional: Get free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ── FRED API ────────────────────────────────
# Get free key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Twelve Data (5 keys for rotation) ──
# Each key: 800 credits/day, 8 req/min
# Total: 4000 credits/day, 40 req/min
# Get free keys from: https://twelvedata.com/
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEY_2=
TWELVE_DATA_API_KEY_3=
TWELVE_DATA_API_KEY_4=
TWELVE_DATA_API_KEY_5=

# ── Finnhub (Optional) ─────────────────────
FINNHUB_API_KEY=

# ── Notifications ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Risk Defaults ───────────────────────────
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_POSITION_SIZE=0.05
MAX_SECTOR_EXPOSURE=0.25
MAX_TRADES_PER_DAY=20
MAX_ORDERS_PER_MINUTE=5
